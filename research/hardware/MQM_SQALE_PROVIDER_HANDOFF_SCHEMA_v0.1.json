{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ud-tetra/MQM/research/hardware/MQM_SQALE_PROVIDER_HANDOFF_SCHEMA_v0.1.json",
  "title": "MQM Sqale Provider Calibration Handoff v0.1",
  "type": "object",
  "required": ["schema_version","provider","backend","calibration_context","compiler_manifest","channels","provenance"],
  "properties": {
    "schema_version": {"const":"0.1"},
    "provider": {"type":"string","const":"Infleqtion"},
    "backend": {
      "type":"object",
      "required":["platform","backend_id","qpu_generation"],
      "properties":{
        "platform":{"type":"string","const":"Sqale"},
        "backend_id":{"type":"string","minLength":1},
        "qpu_generation":{"type":"string","minLength":1},
        "physical_species":{"type":"string"},
        "active_atom_count":{"type":"integer","minimum":1},
        "software_stack_version":{"type":"string"},
        "compiler_version":{"type":"string"}
      },
      "additionalProperties":true
    },
    "calibration_context": {
      "type":"object",
      "required":["start_utc","end_utc","operating_point_id"],
      "properties":{
        "start_utc":{"type":"string","format":"date-time"},
        "end_utc":{"type":"string","format":"date-time"},
        "operating_point_id":{"type":"string"},
        "trap_spacing_um":{"type":"number"},
        "array_geometry":{"type":"string"},
        "notes":{"type":"string"}
      }
    },
    "compiler_manifest": {
      "type":"object",
      "required":["source_circuit_sha256","compiled_circuit_sha256","active_qubits","native_gate_counts","timing_manifest"],
      "properties":{
        "source_circuit_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "compiled_circuit_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "active_qubits":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
        "native_gate_counts":{
          "type":"object",
          "required":["CZ","GR","RZ","NDSSR","RESET"],
          "properties":{
            "CZ":{"type":"integer","minimum":0},
            "GR":{"type":"integer","minimum":0},
            "RZ":{"type":"integer","minimum":0},
            "NDSSR":{"type":"integer","minimum":0},
            "RESET":{"type":"integer","minimum":0},
            "MOVE":{"type":"integer","minimum":0}
          }
        },
        "timing_manifest":{
          "type":"array","minItems":1,
          "items":{
            "type":"object",
            "required":["event_id","family","start_ns","duration_ns","qubits"],
            "properties":{
              "event_id":{"type":"string"},
              "family":{"enum":["CZ","GR","RZ","NDSSR","RESET","IDLE","MOVE","CLASSICAL"]},
              "start_ns":{"type":"number","minimum":0},
              "duration_ns":{"type":"number","minimum":0},
              "qubits":{"type":"array","items":{"type":"string"}},
              "angle_rad":{"type":"number"},
              "axis_phi_rad":{"type":"number"},
              "parallel_group":{"type":"string"}
            }
          }
        }
      }
    },
    "channels": {
      "type":"object",
      "required":["CZ","RZ","GR","PREP","RESET","NDSSR","IDLE","LOSS_DETECTION"],
      "properties":{
        "CZ":{"$ref":"#/$defs/czChannel"},
        "RZ":{"$ref":"#/$defs/rzChannel"},
        "GR":{"$ref":"#/$defs/grChannel"},
        "PREP":{"$ref":"#/$defs/prepResetChannel"},
        "RESET":{"$ref":"#/$defs/prepResetChannel"},
        "NDSSR":{"$ref":"#/$defs/measurementChannel"},
        "IDLE":{"$ref":"#/$defs/idleChannel"},
        "MOVE":{"$ref":"#/$defs/moveChannel"},
        "LOSS_DETECTION":{"$ref":"#/$defs/lossDetectionChannel"},
        "PARALLEL_CROSSTALK":{"$ref":"#/$defs/correlationChannel"}
      }
    },
    "provenance":{
      "type":"object",
      "required":["contact","raw_data_refs","exclusions","uncertainty_method"],
      "properties":{
        "contact":{"type":"string"},
        "raw_data_refs":{"type":"array","items":{"type":"string"}},
        "exclusions":{"type":"array","items":{"type":"string"}},
        "uncertainty_method":{"type":"string"},
        "analysis_code_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs":{
    "estimate":{
      "type":"object",
      "required":["value","uncertainty","shots_or_trials"],
      "properties":{
        "value":{"type":"number"},
        "uncertainty":{"type":"number","minimum":0},
        "shots_or_trials":{"type":"integer","minimum":1},
        "conditioning":{"type":"string"}
      }
    },
    "czChannel":{
      "type":"object",
      "required":["operating_point_id","pair_records"],
      "properties":{
        "operating_point_id":{"type":"string"},
        "pair_records":{"type":"array","minItems":1,"items":{
          "type":"object","required":["pair","retained_error_channel","loss"],
          "properties":{
            "pair":{"type":"array","items":{"type":"string"},"minItems":2,"maxItems":2},
            "retained_error_channel":{"type":"object","description":"Process/PTM/Pauli or source-native five-level channel; fidelity alone is insufficient."},
            "loss":{"type":"object","required":["left_only","right_only","both"],"properties":{
              "left_only":{"$ref":"#/$defs/estimate"},
              "right_only":{"$ref":"#/$defs/estimate"},
              "both":{"$ref":"#/$defs/estimate"}
            }},
            "spectator_error":{"type":"object"}
          }
        }}
      }
    },
    "rzChannel":{
      "type":"object",
      "required":["angle_records"],
      "properties":{"angle_records":{"type":"array","minItems":1,"items":{
        "type":"object","required":["angle_rad","coherent_angle_bias","leakage_by_input"],
        "properties":{
          "angle_rad":{"type":"number"},
          "coherent_angle_bias":{"$ref":"#/$defs/estimate"},
          "leakage_by_input":{"type":"object"},
          "site_dependence":{"type":"object"}
        }
      }}}
    },
    "grChannel":{
      "type":"object",
      "required":["records"],
      "properties":{"records":{"type":"array","minItems":1,"items":{
        "type":"object","required":["theta_rad","phi_rad","overrotation","spatial_covariance"],
        "properties":{
          "theta_rad":{"type":"number"},"phi_rad":{"type":"number"},
          "overrotation":{"$ref":"#/$defs/estimate"},
          "axis_error":{"type":"object"},
          "spatial_covariance":{"type":"object"},
          "shot_to_shot_covariance":{"type":"object"}
        }
      }}}
    },
    "prepResetChannel":{
      "type":"object",
      "required":["records"],
      "properties":{"records":{"type":"array","minItems":1,"items":{
        "type":"object","required":["intended_state","output_distribution","duration_ns"],
        "properties":{
          "intended_state":{"enum":["0","1","+","-"]},
          "prior_measurement_state":{"type":"string"},
          "output_distribution":{"type":"object","description":"Probabilities over 0,1,0_leak,1_leak,loss."},
          "duration_ns":{"type":"number","minimum":0}
        }
      }}}
    },
    "measurementChannel":{
      "type":"object",
      "required":["confusion_by_true_state","loss_by_true_state","duration_ns"],
      "properties":{
        "confusion_by_true_state":{"type":"object","description":"At minimum retain 0->1 and 1->0 separately; include leakage states if available."},
        "loss_by_true_state":{"type":"object"},
        "duration_ns":{"type":"number","minimum":0},
        "repeated_cycle_dependence":{"type":"object"}
      }
    },
    "idleChannel":{
      "type":"object",
      "required":["duration_records"],
      "properties":{"duration_records":{"type":"array","minItems":1,"items":{
        "type":"object","required":["duration_ns","channel","loss"],
        "properties":{
          "duration_ns":{"type":"number","minimum":0},
          "channel":{"type":"object"},
          "loss":{"$ref":"#/$defs/estimate"},
          "trap_configuration":{"type":"string"}
        }
      }}}
    },
    "moveChannel":{
      "type":"object",
      "properties":{"records":{"type":"array","items":{
        "type":"object","required":["distance_um","duration_ns","channel","loss"],
        "properties":{
          "distance_um":{"type":"number","minimum":0},
          "duration_ns":{"type":"number","minimum":0},
          "channel":{"type":"object"},
          "loss":{"$ref":"#/$defs/estimate"},
          "parallel_move_count":{"type":"integer","minimum":1}
        }
      }}}
    },
    "lossDetectionChannel":{
      "type":"object",
      "required":["event_family_records"],
      "properties":{"event_family_records":{"type":"array","minItems":1,"items":{
        "type":"object","required":["event_family","false_negative","false_positive"],
        "properties":{
          "event_family":{"enum":["CZ","NDSSR","RESET","IDLE","MOVE"]},
          "false_negative":{"$ref":"#/$defs/estimate"},
          "false_positive":{"$ref":"#/$defs/estimate"}
        }
      }}}
    },
    "correlationChannel":{
      "type":"object",
      "properties":{
        "parallel_CZ":{"type":"object"},
        "GR_covariance":{"type":"object"},
        "spectator_crosstalk":{"type":"object"}
      }
    }
  }
}
